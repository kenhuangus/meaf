{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudsecurityalliance.org/meaf/meaf-2.0.0.schema.json",
  "title": "MEAF Package",
  "description": "MAESTRO Executable Assurance Framework package schema. Carries the nine linked object types of manuscript appendix A.2 plus the assurance contracts of A.3.",
  "type": "object",
  "required": [
    "meaf-version",
    "package-id",
    "system",
    "components",
    "threats",
    "attack-paths",
    "control-implementations",
    "assurance-contracts",
    "tests",
    "evidence",
    "findings",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "meaf-version": {
      "type": "string",
      "pattern": "^2\\.0\\.0$"
    },
    "package-id": {
      "type": "string",
      "minLength": 1
    },
    "policy-bundle": { "$ref": "#/$defs/policy-bundle-reference" },
    "system": { "$ref": "#/$defs/system" },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" },
      "minItems": 1
    },
    "threats": {
      "type": "array",
      "items": { "$ref": "#/$defs/threat" },
      "minItems": 1
    },
    "attack-paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/attack-path" },
      "minItems": 1
    },
    "control-implementations": {
      "type": "array",
      "items": { "$ref": "#/$defs/control-implementation" },
      "minItems": 1
    },
    "assurance-contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/assurance-contract" },
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/test" },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "lifecycle": { "$ref": "#/$defs/lifecycle" }
  },
  "$defs": {
    "maestro-layer": {
      "type": "string",
      "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"]
    },
    "maestro-node": {
      "description": "A MAESTRO layer paired with a local label, for example L5:locally-benign-evaluation.",
      "type": "string",
      "pattern": "^L[1-7]:[a-z0-9][a-z0-9-]*$"
    },
    "digest": {
      "description": "Content digest. The permitted algorithm set is narrowed further by the policy bundle at conformance level 3.",
      "type": "string",
      "oneOf": [
        { "pattern": "^sha256:[a-f0-9]{64}$" },
        { "pattern": "^sha384:[a-f0-9]{96}$" },
        { "pattern": "^sha512:[a-f0-9]{128}$" }
      ]
    },
    "duration": {
      "description": "ISO 8601 duration restricted to days, hours, minutes and seconds.",
      "type": "string",
      "pattern": "^P(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?(?:\\d+(?:\\.\\d+)?S)?)?$"
    },
    "id-ref": {
      "type": "string",
      "minLength": 1
    },
    "policy-bundle-reference": {
      "description": "The cross-object conformance rules this package was authored against (appendix A.4).",
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "responsible-role": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "party": { "type": "string", "minLength": 1 }
      }
    },
    "system": {
      "description": "Object type 1 of 9: system boundary. Defines exactly what the package covers.",
      "type": "object",
      "required": [
        "id",
        "owner",
        "deployment",
        "environment",
        "data-classes",
        "users",
        "trust-boundaries",
        "critical-outcomes",
        "responsible-roles"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/id-ref" },
        "deployment": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "data-classes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "users": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "trust-boundaries": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "critical-outcomes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "responsible-roles": {
          "description": "Every owner and decision-maker identifier in the package must resolve to one of these roles.",
          "type": "array",
          "items": { "$ref": "#/$defs/responsible-role" },
          "minItems": 1
        }
      }
    },
    "component": {
      "description": "Object type 2 of 9: component and AI bill of materials. Binds claims to deployed artifacts and exposes supply-chain dependencies.",
      "type": "object",
      "required": [
        "id",
        "type",
        "artifact-id",
        "provider",
        "digest",
        "provenance-evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "foundation-model-service",
            "retrieval-collection",
            "adapter",
            "prompt",
            "agent-graph",
            "tool",
            "dataset",
            "policy",
            "memory-store",
            "guardian-agent"
          ]
        },
        "artifact-id": {
          "description": "Weight, endpoint or snapshot identifier for the deployed artifact.",
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "description": "Supplying party. Use the deploying organisation for artifacts built in-house.",
          "type": "string",
          "minLength": 1
        },
        "digest": { "$ref": "#/$defs/digest" },
        "artifact-path": { "type": "string", "minLength": 1 },
        "dependencies": {
          "description": "Other component identifiers this component depends on.",
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" }
        },
        "provenance-evidence": { "$ref": "#/$defs/id-ref" }
      }
    },
    "detection-horizon": {
      "description": "Minimum sequence length or observation period a detector needs before the threat becomes visible.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "minimum-observations": { "type": "integer", "minimum": 1 },
        "observation-period": { "$ref": "#/$defs/duration" }
      }
    },
    "recovery-objective": {
      "type": "object",
      "required": ["max-containment-time", "max-acceptable-loss"],
      "additionalProperties": false,
      "properties": {
        "max-containment-time": { "$ref": "#/$defs/duration" },
        "max-acceptable-loss": {
          "description": "Maximum acceptable loss of legitimate state, stated in the units the recovery procedure restores.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporal-profile": {
      "description": "Makes long-running risk explicit rather than burying it in prose (appendix A.2).",
      "type": "object",
      "required": [
        "persistence",
        "activation-latency",
        "exposure-unit",
        "compounding-rule",
        "dormancy",
        "detection-horizon",
        "reversibility",
        "recovery-objective"
      ],
      "additionalProperties": false,
      "properties": {
        "persistence": {
          "type": "string",
          "enum": [
            "session",
            "cross-session",
            "model-version",
            "agent-identity",
            "ecosystem"
          ]
        },
        "activation-latency": {
          "oneOf": [
            { "$ref": "#/$defs/duration" },
            {
              "type": "string",
              "enum": ["immediate", "trigger-conditional", "unbounded", "unknown"]
            }
          ]
        },
        "exposure-unit": {
          "type": "string",
          "enum": [
            "turn",
            "retrieval",
            "memory-write",
            "tool-call",
            "delegation",
            "task",
            "wall-clock-interval"
          ]
        },
        "compounding-rule": {
          "type": "string",
          "enum": [
            "none",
            "cumulative",
            "thresholded",
            "feedback-driven",
            "specified-function"
          ]
        },
        "dormancy": {
          "type": "string",
          "enum": ["none", "trigger-conditional", "condition-conditional", "unknown"]
        },
        "dormancy-trigger": { "type": "string", "minLength": 1 },
        "detection-horizon": { "$ref": "#/$defs/detection-horizon" },
        "reversibility": {
          "type": "string",
          "enum": [
            "automatic",
            "checkpoint-dependent",
            "reconstruction-dependent",
            "model-replacement",
            "unknown"
          ]
        },
        "recovery-objective": { "$ref": "#/$defs/recovery-objective" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dormancy": {
                "enum": ["trigger-conditional", "condition-conditional"]
              }
            },
            "required": ["dormancy"]
          },
          "then": { "required": ["dormancy-trigger"] }
        }
      ]
    },
    "threat": {
      "description": "Object type 3 of 9: threat. Converts a narrative threat into the testable tuple T = (actor, capability, stage, preconditions, entry, path, objective, target, outcome, temporal-profile).",
      "type": "object",
      "required": [
        "id",
        "actor",
        "capabilities",
        "stage",
        "preconditions",
        "attack-classes",
        "objective",
        "entry-layers",
        "path",
        "target",
        "affected-stakeholders",
        "outcomes",
        "temporal-profile"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "capabilities": {
          "description": "Prefer stable external identifiers, for example NISTAML:model-control.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "stage": {
          "description": "Lifecycle stage at which the attacker acts.",
          "type": "string",
          "enum": [
            "supply-chain",
            "training",
            "fine-tuning",
            "build",
            "deployment",
            "runtime",
            "decommission"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "attack-classes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "objective": { "type": "string", "minLength": 1 },
        "entry-layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/maestro-layer" },
          "minItems": 1
        },
        "path": { "$ref": "#/$defs/id-ref" },
        "target": {
          "description": "The affected asset. Component identifier, system identifier, or a named data class.",
          "type": "string",
          "minLength": 1
        },
        "affected-stakeholders": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "outcomes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "temporal-profile": { "$ref": "#/$defs/temporal-profile" }
      }
    },
    "attack-path": {
      "description": "Object type 4 of 9: attack path. Makes cross-layer propagation and interruption points explicit.",
      "type": "object",
      "required": ["id", "nodes", "edges", "impact"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/maestro-node" },
          "minItems": 2
        },
        "edges": {
          "description": "Typed edge between consecutive nodes. Length must be one less than nodes.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "data-flow",
              "control-flow",
              "trust-flow",
              "privilege-flow",
              "memory-flow",
              "evidence-gap"
            ]
          },
          "minItems": 1
        },
        "impact": {
          "description": "Impact of the harmful outcome at the end of this path. Drives the interruption requirements the policy bundle enforces.",
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "control-implementation": {
      "description": "Object type 5 of 9: control implementation. States HOW and WHERE a threat is interrupted. Paired with one or more assurance contracts that state how the interruption is verified.",
      "type": "object",
      "required": [
        "id",
        "description",
        "function",
        "owner",
        "implementation-location",
        "dependencies",
        "enforcement-mode",
        "failure-behavior",
        "attack-paths",
        "interruption-point",
        "interruption-type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "function": {
          "type": "string",
          "enum": ["prevent", "detect", "contain", "recover"]
        },
        "owner": { "$ref": "#/$defs/id-ref" },
        "implementation-location": {
          "description": "MAESTRO node where the control itself runs. May differ from the node it interrupts.",
          "$ref": "#/$defs/maestro-node"
        },
        "dependencies": {
          "description": "Component or control identifiers this control depends on. An empty array asserts no dependencies.",
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" }
        },
        "enforcement-mode": {
          "type": "string",
          "enum": ["enforcing", "monitoring", "advisory"]
        },
        "failure-behavior": {
          "description": "Behaviour when the control itself fails or is unavailable.",
          "type": "string",
          "enum": ["fail-closed", "fail-open", "degrade", "alert-only"]
        },
        "attack-paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" },
          "minItems": 1
        },
        "interruption-point": {
          "description": "Node on the referenced attack paths that this control interrupts.",
          "$ref": "#/$defs/maestro-node"
        },
        "interruption-type": {
          "type": "string",
          "enum": [
            "blocks",
            "detects",
            "limits",
            "contains",
            "restores",
            "supports-investigation"
          ]
        }
      }
    },
    "assurance-contract": {
      "description": "Appendix A.3: the smallest independently evaluable unit. States what must be observed for the paired control implementation to count as working. AC = (claim, subject, threats, function, test, threshold, evidence, cadence, failure-action, owner).",
      "type": "object",
      "required": [
        "id",
        "claim",
        "subject",
        "control",
        "threats",
        "function",
        "test",
        "decision-rule",
        "required-evidence",
        "evidence-classes",
        "evidence-max-age",
        "cadence",
        "failure-action",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "claim": {
          "description": "A falsifiable statement, for example 'only signed model artifacts may be loaded'.",
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "description": "The exact artifact or runtime boundary the claim is about. Component identifier or system identifier.",
          "$ref": "#/$defs/id-ref"
        },
        "control": {
          "description": "The control implementation this contract verifies.",
          "$ref": "#/$defs/id-ref"
        },
        "threats": {
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" },
          "minItems": 1
        },
        "function": {
          "description": "Must equal the function of the referenced control implementation.",
          "type": "string",
          "enum": ["prevent", "detect", "contain", "recover"]
        },
        "test": { "$ref": "#/$defs/id-ref" },
        "decision-rule": {
          "description": "Thresholds applied to test metrics. Keys ending -max, -min or -exact are evaluated; minimum-<unit> keys assert sampling adequacy.",
          "type": "object"
        },
        "required-evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" },
          "minItems": 1
        },
        "evidence-classes": {
          "description": "Evidence classes acceptable for this contract.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["deterministic-observation", "probabilistic-inference"]
          },
          "minItems": 1
        },
        "evidence-max-age": {
          "description": "Freshness this contract requires, independent of what an individual evidence item declares.",
          "$ref": "#/$defs/duration"
        },
        "cadence": {
          "type": "string",
          "minLength": 1
        },
        "failure-action": {
          "type": "string",
          "enum": [
            "alert",
            "degrade-privileges",
            "block-deployment",
            "suspend-autonomous-operation",
            "quarantine-memory",
            "invoke-recovery"
          ]
        },
        "failure-action-detail": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/id-ref" }
      }
    },
    "test": {
      "description": "Object type 6 of 9: test. A reproducible challenge to a control claim.",
      "type": "object",
      "required": [
        "id",
        "procedure",
        "target",
        "adversarial",
        "inputs",
        "oracle",
        "metrics",
        "thresholds",
        "sampling-plan",
        "expected-result",
        "test-pack-version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "procedure": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/id-ref" },
        "adversarial": {
          "description": "True when the test exercises attacker behaviour. Adversarial tests must also report benign-task utility (appendix A.7).",
          "type": "boolean"
        },
        "inputs": { "type": "object" },
        "oracle": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "thresholds": { "type": "object" },
        "utility-metrics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "utility-thresholds": {
          "description": "Minimum benign-task utility the gate requires. Prevents a control that refuses everything from scoring as secure.",
          "type": "object"
        },
        "sampling-plan": { "type": "string", "minLength": 1 },
        "expected-result": {
          "type": "string",
          "enum": ["pass", "fail", "indeterminate"]
        },
        "test-pack-version": {
          "description": "Pinned pack identifier, for example epistemic-integrity-harness:1.0.0.",
          "type": "string",
          "minLength": 1
        },
        "test-pack": {
          "description": "Identifier of a registered standard test pack (appendix A.7).",
          "type": "string",
          "minLength": 1
        },
        "evidence-max-age": { "$ref": "#/$defs/duration" },
        "evidence-class": {
          "description": "Class of the evidence this test produces. Required when the test has a runner, so an LLM-judged result cannot be emitted as a deterministic observation.",
          "type": "string",
          "enum": ["deterministic-observation", "probabilistic-inference"]
        },
        "runner": { "$ref": "#/$defs/runner" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "adversarial": { "const": true } },
            "required": ["adversarial"]
          },
          "then": { "required": ["utility-metrics", "utility-thresholds"] }
        },
        {
          "if": { "required": ["runner"] },
          "then": { "required": ["evidence-class"] }
        }
      ]
    },
    "runner": {
      "type": "object",
      "required": ["command", "timeout-seconds"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Argument vector. A leading 'python' or 'python3' resolves to the interpreter running MEAF.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "timeout-seconds": { "type": "integer", "minimum": 1 },
        "working-directory": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key-id", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "const": "ed25519" },
        "key-id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "history"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "validated",
            "assessed",
            "authorized",
            "degraded",
            "suspended",
            "retired"
          ]
        },
        "history": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle-transition" }
        }
      }
    },
    "lifecycle-transition": {
      "type": "object",
      "required": ["from", "to", "at", "actor", "reason"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      }
    },
    "model-metadata": {
      "description": "Required for probabilistic inference. Appendix A.5 requires evaluator model and prompt, calibration set, threshold, uncertainty, known failure modes, and an independent escalation path.",
      "type": "object",
      "required": [
        "evaluator-model",
        "evaluator-prompt-digest",
        "threshold",
        "calibration-set",
        "uncertainty",
        "known-failure-modes",
        "escalation-path"
      ],
      "additionalProperties": false,
      "properties": {
        "evaluator-model": { "type": "string", "minLength": 1 },
        "evaluator-prompt-digest": { "$ref": "#/$defs/digest" },
        "threshold": { "type": "number" },
        "calibration-set": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "string", "minLength": 1 },
        "known-failure-modes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "escalation-path": {
          "description": "Where a disputed judgment goes for independent adjudication.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "description": "Object type 7 of 9: evidence. Records attributable observations without conflating them with claims.",
      "type": "object",
      "required": [
        "id",
        "class",
        "subject-digests",
        "source",
        "method",
        "collector",
        "collected-at",
        "max-age",
        "invalidated-at",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class": {
          "type": "string",
          "enum": ["deterministic-observation", "probabilistic-inference"]
        },
        "subject-digests": {
          "description": "Digests of the artifacts this observation was made against. Empty only for evidence about the system as a whole rather than an artifact.",
          "type": "array",
          "items": { "$ref": "#/$defs/digest" }
        },
        "source": {
          "description": "System of record the evidence was retrieved from.",
          "type": "string",
          "minLength": 1
        },
        "method": { "type": "string", "minLength": 1 },
        "collector": {
          "description": "Versioned collector identity, name:major.minor.patch.",
          "type": "string",
          "minLength": 1
        },
        "collected-at": { "type": "string", "format": "date-time" },
        "max-age": { "$ref": "#/$defs/duration" },
        "invalidated-at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "indeterminate"]
        },
        "signature": { "$ref": "#/$defs/signature" },
        "model-metadata": { "$ref": "#/$defs/model-metadata" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": { "const": "probabilistic-inference" }
            },
            "required": ["class"]
          },
          "then": { "required": ["model-metadata"] }
        },
        {
          "if": {
            "properties": {
              "class": { "const": "deterministic-observation" }
            },
            "required": ["class"]
          },
          "then": {
            "not": { "required": ["model-metadata"] }
          }
        }
      ]
    },
    "finding": {
      "description": "Object type 8 of 9: finding and remediation. Carries failed assurance into tracked remediation.",
      "type": "object",
      "required": [
        "id",
        "failed-claim",
        "severity",
        "affected-paths",
        "root-cause",
        "corrective-action",
        "due-date",
        "retest-reference"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "failed-claim": { "$ref": "#/$defs/id-ref" },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "in-progress", "resolved", "risk-accepted"]
        },
        "detected-at": { "type": "string", "format": "date-time" },
        "affected-paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" },
          "minItems": 1
        },
        "root-cause": { "type": "string", "minLength": 1 },
        "corrective-action": { "type": "string", "minLength": 1 },
        "due-date": { "type": "string", "format": "date" },
        "retest-reference": { "$ref": "#/$defs/id-ref" }
      }
    },
    "decision": {
      "description": "Object type 9 of 9: decision and exception. Prevents automated checks from becoming unowned risk acceptance.",
      "type": "object",
      "required": [
        "id",
        "decision-type",
        "gate-decision",
        "policy-used",
        "decision-maker",
        "residual-risk",
        "scope",
        "justification",
        "expiry",
        "compensating-controls"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "decision-type": {
          "description": "authorization gates the package; exception time-bounds a known failure; not-applicable declares a contract out of scope.",
          "type": "string",
          "enum": ["authorization", "exception", "not-applicable"]
        },
        "gate-decision": {
          "type": "string",
          "enum": ["approve", "approve-with-conditions", "deny", "defer"]
        },
        "applies-to": {
          "description": "Assurance contract identifiers this decision scopes. Required for exception and not-applicable decisions.",
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" }
        },
        "policy-used": { "type": "string", "minLength": 1 },
        "decision-maker": { "$ref": "#/$defs/id-ref" },
        "residual-risk": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "expiry": { "type": "string", "format": "date" },
        "compensating-controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/id-ref" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision-type": { "enum": ["exception", "not-applicable"] }
            },
            "required": ["decision-type"]
          },
          "then": {
            "required": ["applies-to"],
            "properties": {
              "applies-to": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
